# Copy to .env for local Compose use. Replace every placeholder before starting.
DB_USERNAME=avron
DB_PASSWORD=replace-with-a-unique-password
SCANNER_API_KEY=replace-with-a-unique-api-key

# Optional: raises the NVD API request limit for CVE enrichment.
NVD_API_KEY=

# Optional runtime settings.
SCAN_TIMEOUT_SECONDS=600
METRICS_ENABLED=true
LOG_LEVEL=INFO
